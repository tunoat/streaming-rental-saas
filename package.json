    "gmail-worker:register": "node apps/api/cli.mjs gmail-worker",
    "gmail-worker": "node apps/gmail-worker/worker.mjs",
    "types:gmail": "openapi-typescript contracts/openapi.email-bot.v1.yaml -o packages/shared/gmail-contract.d.ts",
    "types": "openapi-typescript contracts/openapi.bot-control.v1.yaml -o packages/shared/bot-contract.d.ts",
    "build": "tsc -p tsconfig.json",
    "seed": "node database/seed.mjs",
    "lint": "node scripts/lint.mjs",
    "contract:lint": "redocly lint --extends minimal contracts/openapi.bot-control.v1.yaml contracts/openapi.bot-control.v1.headers-proposed.yaml contracts/openapi.email-bot.v1.yaml",
    "test:browser": "playwright test",
    "backup:drill": "node scripts/backup-drill.mjs"
  },
